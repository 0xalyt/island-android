+package com.pally.island;
+
+/** Reads notification text only when previews are enabled and provides a redacted snapshot otherwise. */
+final class NotificationPreviewText {
+    interface ExtraReader {
+        CharSequence title();
+        CharSequence bigText();
+        CharSequence text();
+    }
+
+    static final NotificationPreviewText EMPTY = new NotificationPreviewText("", "");
+    final String title;
+    final String body;
+
+    NotificationPreviewText(String title, String body) {
+        this.title = title == null ? "" : title;
+        this.body = body == null ? "" : body;
+    }
+
+    static NotificationPreviewText capture(boolean enabled, ExtraReader reader) {
+        if (!enabled || reader == null) return EMPTY;
+        CharSequence title = reader.title();
+        CharSequence body = reader.bigText();
+        if (isEmpty(body)) body = reader.text();
+        return new NotificationPreviewText(normalize(title), normalize(body));
+    }
+
+    static NotificationPreviewText forDisplay(boolean enabled, NotificationPreviewText current) {
+        if (!enabled || current == null) return EMPTY;
+        return current;
+    }
+
+    private static boolean isEmpty(CharSequence value) {
+        return value == null || value.length() == 0;
+    }
+
+    private static String normalize(CharSequence value) {
+        if (value == null) return "";
+        String text = value.toString().replace('\n', ' ').replace('\r', ' ').trim();
+        if (text.length() > 120) text = text.substring(0, 119) + "…";
+        return text;
+    }
+}
