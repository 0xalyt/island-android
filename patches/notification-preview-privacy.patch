+package com.pally.island;
+
+import org.junit.Test;
+import static org.junit.Assert.assertEquals;
+
+public final class NotificationPreviewTextTest {
+    @Test public void disabledPreviewsDoNotInvokeExtraReaderAndReturnBlankText() {
+        final int[] reads = {0};
+        NotificationPreviewText result = NotificationPreviewText.capture(false,
+                new NotificationPreviewText.ExtraReader() {
+                    @Override public CharSequence title() { reads[0]++; return "secret title"; }
+                    @Override public CharSequence bigText() { reads[0]++; return "secret body"; }
+                    @Override public CharSequence text() { reads[0]++; return "fallback"; }
+                });
+        assertEquals(0, reads[0]);
+        assertEquals("", result.title);
+        assertEquals("", result.body);
+    }
+
+    @Test public void enabledPreviewsCaptureAndNormalizeText() {
+        final int[] reads = {0};
+        NotificationPreviewText result = NotificationPreviewText.capture(true,
+                new NotificationPreviewText.ExtraReader() {
+                    @Override public CharSequence title() { reads[0]++; return "  hello\nworld  "; }
+                    @Override public CharSequence bigText() { reads[0]++; return "full body"; }
+                    @Override public CharSequence text() { reads[0]++; return "fallback"; }
+                });
+        assertEquals(2, reads[0]);
+        assertEquals("hello world", result.title);
+        assertEquals("full body", result.body);
+    }
+
+    @Test public void enabledPreviewsUseNotificationTextAsBodyFallback() {
+        NotificationPreviewText result = NotificationPreviewText.capture(true,
+                new NotificationPreviewText.ExtraReader() {
+                    @Override public CharSequence title() { return "title"; }
+                    @Override public CharSequence bigText() { return ""; }
+                    @Override public CharSequence text() { return "short body"; }
+                });
+        assertEquals("short body", result.body);
+    }
+
+    @Test public void disablingPreviewsRedactsAnExistingSnapshot() {
+        NotificationPreviewText existing = new NotificationPreviewText("secret title", "secret body");
+        NotificationPreviewText cleared = NotificationPreviewText.forDisplay(false, existing);
+        assertEquals("", cleared.title);
+        assertEquals("", cleared.body);
+    }
+}
