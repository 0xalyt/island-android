+package com.pally.island;
+
+/** Maps tap coordinates to the exact rectangular bounds used for the visible notification buttons. */
+final class NotificationActionHitTest {
+    private NotificationActionHitTest() { }
+
+    static int actionIndexAt(float x, float y, int viewWidth, int viewHeight,
+                             float density, int actionCount) {
+        if (!Float.isFinite(x) || !Float.isFinite(y) || !Float.isFinite(density)
+                || density <= 0f || viewWidth <= 0 || viewHeight <= 0 || actionCount <= 0) {
+            return -1;
+        }
+        int count = Math.min(2, actionCount);
+        float left = dp(18f, density);
+        float gap = dp(8f, density);
+        float usable = viewWidth - dp(36f, density);
+        float buttonWidth = (usable - (count - 1) * gap) / count;
+        float top = viewHeight - dp(42f, density);
+        float bottom = viewHeight - dp(12f, density);
+        if (buttonWidth <= 0f || bottom < top) return -1;
+
+        for (int index = 0; index < count; index++) {
+            float buttonLeft = left + index * (buttonWidth + gap);
+            float buttonRight = buttonLeft + buttonWidth;
+            if (x >= buttonLeft && x <= buttonRight && y >= top && y <= bottom) {
+                return index;
+            }
+        }
+        return -1;
+    }
+
+    private static int dp(float value, float density) {
+        return (int) (value * density + 0.5f);
+    }
+}
