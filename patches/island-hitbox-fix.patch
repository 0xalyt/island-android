+package com.pally.island;
+
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+
+public final class NotificationActionHitTestTest {
+    @Test public void targetsOnlyTheVisibleButtonRectsAndLeavesTheGapInactive() {
+        int width = 340;
+        int height = 186;
+        float density = 1f;
+        assertEquals(0, NotificationActionHitTest.actionIndexAt(18, 144, width, height, density, 2));
+        assertEquals(0, NotificationActionHitTest.actionIndexAt(166, 174, width, height, density, 2));
+        assertEquals(1, NotificationActionHitTest.actionIndexAt(174, 144, width, height, density, 2));
+        assertEquals(1, NotificationActionHitTest.actionIndexAt(322, 174, width, height, density, 2));
+        assertEquals(-1, NotificationActionHitTest.actionIndexAt(170, 150, width, height, density, 2));
+        assertEquals(-1, NotificationActionHitTest.actionIndexAt(17, 150, width, height, density, 2));
+        assertEquals(-1, NotificationActionHitTest.actionIndexAt(323, 150, width, height, density, 2));
+        assertEquals(-1, NotificationActionHitTest.actionIndexAt(25, 143, width, height, density, 2));
+        assertEquals(-1, NotificationActionHitTest.actionIndexAt(25, 175, width, height, density, 2));
+    }
+
+    @Test public void rejectsTheFormerBroadHitBandAndClampedOutsideTap() {
+        // At this size the former code accepted y >= 132 and clamped any x to an action.
+        assertEquals(-1, NotificationActionHitTest.actionIndexAt(30, 133, 340, 186, 1f, 2));
+        assertEquals(-1, NotificationActionHitTest.actionIndexAt(330, 150, 340, 186, 1f, 2));
+    }
+
+    @Test public void singleActionUsesTheSingleDrawnButtonAndExtraActionsAreNotExposed() {
+        assertEquals(0, NotificationActionHitTest.actionIndexAt(300, 160, 340, 186, 1f, 1));
+        assertEquals(0, NotificationActionHitTest.actionIndexAt(170, 150, 340, 186, 1f, 1));
+        assertEquals(-1, NotificationActionHitTest.actionIndexAt(17, 150, 340, 186, 1f, 1));
+        assertEquals(1, NotificationActionHitTest.actionIndexAt(180, 150, 340, 186, 1f, 4));
+    }
+
+    @Test public void scalesBoundsWithDisplayDensity() {
+        assertEquals(0, NotificationActionHitTest.actionIndexAt(40, 300, 680, 372, 2f, 2));
+        assertEquals(-1, NotificationActionHitTest.actionIndexAt(340, 300, 680, 372, 2f, 2));
+        assertEquals(1, NotificationActionHitTest.actionIndexAt(400, 300, 680, 372, 2f, 2));
+        assertEquals(-1, NotificationActionHitTest.actionIndexAt(400, 350, 680, 372, 2f, 2));
+    }
+
+    @Test public void rejectsInvalidInputs() {
+        assertEquals(-1, NotificationActionHitTest.actionIndexAt(1, 1, 0, 186, 1f, 2));
+        assertEquals(-1, NotificationActionHitTest.actionIndexAt(1, 1, 340, 186, 0f, 2));
+        assertEquals(-1, NotificationActionHitTest.actionIndexAt(Float.NaN, 1, 340, 186, 1f, 2));
+        assertEquals(-1, NotificationActionHitTest.actionIndexAt(1, 1, 340, 186, 1f, 0));
+    }
+}
